<Window x:Class="DevicePower.BatteryPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DevicePower"
        Title="外设电量"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        MouseRightButtonUp="Window_MouseRightButtonUp"
        KeyDown="Window_KeyDown">
    <Border CornerRadius="14" Background="#E6323232" Padding="20,12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <ItemsControl x:Name="Rows">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Height="{Binding Source={StaticResource Look}, Path=PanelRowHeight}" Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Source={StaticResource Look}, Path=PanelSlotOne}" />
                            <ColumnDefinition Width="{Binding Source={StaticResource Look}, Path=PanelSlotTwo}" />
                            <ColumnDefinition Width="{Binding Source={StaticResource Look}, Path=PanelPercentSlot}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="{Binding Source={StaticResource Look}, Path=NameColumn}"
                                   Text="{Binding Name}"
                                   FontSize="{Binding Source={StaticResource Look}, Path=PanelNameFontSize}"
                                   FontWeight="{Binding Source={StaticResource Look}, Path=NameWeight}"
                                   Foreground="{Binding Source={StaticResource Look}, Path=TextBrush}"
                                   Visibility="{Binding Source={StaticResource Look}, Path=NameVisibility}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />
                        <local:BatteryGlyph Grid.Column="{Binding Source={StaticResource Look}, Path=GlyphColumn}"
                                            Level="{Binding Level}"
                                            Charging="{Binding IsCharging}"
                                            GlyphStyle="{Binding Source={StaticResource Look}, Path=GlyphStyle}"
                                            ChargingStyle="{Binding Source={StaticResource Look}, Path=ChargingStyle}"
                                            AnimationEnabled="{Binding Source={StaticResource Look}, Path=GlyphAnimation}"
                                            Width="{Binding Source={StaticResource Look}, Path=PanelGlyphWidth}"
                                            Height="{Binding Source={StaticResource Look}, Path=PanelGlyphHeight}"
                                            VerticalAlignment="Center"
                                            Margin="{Binding Source={StaticResource Look}, Path=PanelGlyphMargin}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding PercentText}"
                                   FontSize="{Binding Source={StaticResource Look}, Path=PanelPercentFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{Binding PercentBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>

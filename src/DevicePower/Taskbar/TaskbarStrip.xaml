<Window x:Class="DevicePower.Taskbar.TaskbarStrip"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DevicePower"
        Title="DevicePowerStrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="DeviceRowTemplate">
            <Grid Height="{Binding Source={StaticResource Look}, Path=StripRowHeight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Source={StaticResource Look}, Path=StripSlotOne}" />
                    <ColumnDefinition Width="{Binding Source={StaticResource Look}, Path=StripSlotTwo}" />
                    <ColumnDefinition Width="{Binding Source={StaticResource Look}, Path=StripPercentSlot}" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="{Binding Source={StaticResource Look}, Path=NameColumn}"
                           Text="{Binding Name}"
                           FontSize="{Binding Source={StaticResource Look}, Path=StripNameFontSize}"
                           FontWeight="{Binding Source={StaticResource Look}, Path=NameWeight}"
                           Foreground="{Binding Source={StaticResource Look}, Path=TextBrush}"
                           Visibility="{Binding Source={StaticResource Look}, Path=NameVisibility}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,6,0" />
                <local:BatteryGlyph Grid.Column="{Binding Source={StaticResource Look}, Path=GlyphColumn}"
                                    Level="{Binding Level}"
                                    Charging="{Binding IsCharging}"
                                    GlyphStyle="{Binding Source={StaticResource Look}, Path=GlyphStyle}"
                                    ChargingStyle="{Binding Source={StaticResource Look}, Path=ChargingStyle}"
                                    AnimationEnabled="{Binding Source={StaticResource Look}, Path=GlyphAnimation}"
                                    Width="{Binding Source={StaticResource Look}, Path=StripGlyphWidth}"
                                    Height="{Binding Source={StaticResource Look}, Path=StripGlyphHeight}"
                                    VerticalAlignment="Center"
                                    Margin="{Binding Source={StaticResource Look}, Path=StripGlyphMargin}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding PercentText}"
                           FontSize="{Binding Source={StaticResource Look}, Path=StripPercentFontSize}"
                           FontWeight="Bold"
                           Foreground="{Binding PercentBrush}"
                           VerticalAlignment="Center"
                           TextAlignment="Right" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ColumnTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Width="1"
                        Height="16"
                        Background="#1FFFFFFF"
                        Margin="7,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceRowTemplate}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Chrome"
            Background="#01000000"
            CornerRadius="6"
            Padding="8,2">
        <ItemsControl ItemsSource="{Binding Columns}" ItemTemplate="{StaticResource ColumnTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Border>
</Window>

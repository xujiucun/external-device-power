<Window x:Class="DevicePower.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Topmost="True"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="4,1" Padding="12,7">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#1FFFFFFF" Margin="10,4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border CornerRadius="10"
                Background="#F2202020"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Padding="3">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.5" Color="Black" />
            </Border.Effect>
            <StackPanel Margin="0,2">
                <Button Content="设置..." Style="{StaticResource MenuButton}" Click="Settings_Click" />
                <Button Content="显示 / 隐藏浮动面板" Style="{StaticResource MenuButton}" Click="TogglePanel_Click" />
                <Button Content="立即刷新" Style="{StaticResource MenuButton}" Click="Refresh_Click" />
                <Separator Style="{StaticResource MenuSeparator}" />
                <Button Content="关于" Style="{StaticResource MenuButton}" Click="About_Click" />
                <Button Content="退出" Style="{StaticResource MenuButton}" Click="Exit_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

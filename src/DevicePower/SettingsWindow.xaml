<Window x:Class="DevicePower.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Icon="pack://application:,,,/Assets/hlogo.ico"
        Width="760"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="15"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>

        <!-- ================= 输入框 ================= -->
        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="#2F6BFF" />
            <Setter Property="Background" Value="#16FFFFFF" />
            <Setter Property="BorderBrush" Value="#2EFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,9" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2F6BFF" />
                                <Setter TargetName="Bd" Property="Background" Value="#1F2F6BFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= 按钮 ================= -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Foreground" Value="#E8EBF0" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="17,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0CFFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2F6BFF" />
            <Setter Property="BorderBrush" Value="#5C8CFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="17,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outer" CornerRadius="11" Padding="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#4A82FF" Offset="0" />
                                    <GradientStop Color="#2A5FE0" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#2F6BFF" BlurRadius="14" ShadowDepth="3"
                                                  Opacity="0.42" Direction="270" />
                            </Border.Effect>
                            <Border x:Name="Bd"
                                    CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A7DFF" />
                                <Setter TargetName="Outer" Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2550C4" />
                                <Setter TargetName="Outer" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B3FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= 单选 / 复选 ================= -->
        <Style x:Key="OptionStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E6E8EB" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,26,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" StrokeThickness="1.6" Stroke="#66FFFFFF" Fill="#14FFFFFF" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="White" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#2F6BFF" />
                                <Setter TargetName="Ring" Property="Fill" Value="#2F6BFF" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#A6FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Switch 开关：44×26 轨道 + 18 圆形滑块，勾选时蓝色、滑块右移 -->
        <Style x:Key="CheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E8EB" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="44" Height="26" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="13" Background="#31343A" />
                                <Ellipse x:Name="Knob" Width="18" Height="18" Fill="#E8EBF0"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="KnobMove" X="0" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.25" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3B3F46" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2F6BFF" />
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                                <Setter Property="Foreground" Value="White" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobMove"
                                                             Storyboard.TargetProperty="X"
                                                             To="18" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobMove"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= 滑块 ================= -->
        <Style x:Key="TrackRepeatStyle" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" CornerRadius="3" Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Shadow" Fill="#40000000" Margin="1,2,-1,-2" />
                            <Ellipse x:Name="Body" Fill="White" Stroke="#33000000" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Fill" Value="#F2F5FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderStyle" TargetType="Slider">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="#28FFFFFF" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackRepeatStyle}"
                                                  Background="#2F6BFF"
                                                  Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackRepeatStyle}"
                                                  Background="#00FFFFFF"
                                                  Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 颜色色板：Tag 放颜色，选中有白圈 -->
        <Style x:Key="SwatchStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="26" Height="26">
                            <Border x:Name="Ring" CornerRadius="10" Margin="-3"
                                    BorderThickness="2" BorderBrush="#00FFFFFF" />
                            <Border x:Name="Chip" CornerRadius="7" BorderThickness="1" BorderBrush="#4DFFFFFF"
                                    Background="{Binding Tag, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#80FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= 文本层级 ================= -->
        <Style x:Key="KeyStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A8AEB8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DEE1E6" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SliderValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowStyle" TargetType="Grid">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SectionStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,18,0,10" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#858B95" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RuleStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#1CFFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="14,0,0,0" />
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7C828B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 暗色细滚动条（内容超高时只在右侧出现一条 8px 滑块） -->
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar" CornerRadius="2" Background="#26FFFFFF" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                  Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                  Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20"
            Background="#FA202020"
            BorderBrush="#38FFFFFF"
            BorderThickness="1"
            Padding="30,22"
            MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Background="Transparent" Margin="0,0,0,4">
                <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right"
                        Style="{StaticResource IconButton}" Click="Cancel_Click" />
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="BodyScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0"
                              Focusable="False">
                    <StackPanel>

            <!-- 设备名称 -->
            <Grid Style="{StaticResource SectionStyle}" Margin="0,6,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="设备名称" Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Column="1" Style="{StaticResource RuleStyle}" />
            </Grid>

            <ItemsControl x:Name="DeviceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FamilyLabel}" Style="{StaticResource KeyStyle}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldStyle}"
                                     MaxLength="24" Margin="0,0,12,0" />
                            <CheckBox Grid.Column="2" Content="显示"
                                      IsChecked="{Binding Visible}"
                                      Style="{StaticResource CheckStyle}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoDeviceText"
                       Text="还没发现设备：插好接收器、唤醒设备后再打开设置。"
                       Style="{StaticResource HintStyle}"
                       Margin="0,0,0,10" />
            <TextBlock Style="{StaticResource HintStyle}"
                       Margin="0,0,0,10"
                       Text="取消勾选的设备不再显示，后台也不再读取它的电量；重新勾选后下一次刷新恢复。" />

            <!-- 显示 -->
            <Grid Style="{StaticResource SectionStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="显示" Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Column="1" Style="{StaticResource RuleStyle}" />
            </Grid>

            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="显示为" Style="{StaticResource KeyStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="ModeTaskbar" Content="任务栏电量条" GroupName="DisplayMode"
                                 Style="{StaticResource OptionStyle}" />
                    <RadioButton x:Name="ModePanel" Content="浮动面板" GroupName="DisplayMode"
                                 Style="{StaticResource OptionStyle}" />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource RowStyle}" IsEnabled="{Binding IsChecked, ElementName=ModeTaskbar}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="电量条位置" Style="{StaticResource KeyStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="SideRight" Content="靠托盘" GroupName="TaskbarSide"
                                 Style="{StaticResource OptionStyle}" />
                    <RadioButton x:Name="SideLeft" Content="靠开始按钮" GroupName="TaskbarSide"
                                 Style="{StaticResource OptionStyle}" />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="全屏时" Style="{StaticResource KeyStyle}" />
                <CheckBox Grid.Column="1" x:Name="FullscreenBox"
                          Content="浮动面板有窗口铺满整块屏幕（全屏游戏）时自动隐藏，退出后自动回来"
                          Style="{StaticResource CheckStyle}" />
            </Grid>

            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="托盘图标" Style="{StaticResource KeyStyle}" />
                <TextBlock Grid.Column="1" x:Name="TrayIconText" Style="{StaticResource ValueStyle}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                <Button Grid.Column="2" Content="选择…" Margin="0,0,9,0"
                        Style="{StaticResource SecondaryButton}" Click="PickTrayIcon_Click" />
                <Button Grid.Column="3" Content="恢复内置"
                        Style="{StaticResource SecondaryButton}" Click="ResetTrayIcon_Click" />
            </Grid>

            <!-- 读数与提醒 -->
            <Grid Style="{StaticResource SectionStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="读数与提醒" Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Column="1" Style="{StaticResource RuleStyle}" />
            </Grid>

            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="当前读数" Style="{StaticResource KeyStyle}" />
                <TextBlock Grid.Column="1" x:Name="CalibrationText" Style="{StaticResource ValueStyle}"
                           TextWrapping="Wrap" Margin="0,0,12,0" />
                <Button Grid.Column="2" x:Name="ReReadButton" Content="重新读取"
                        Style="{StaticResource SecondaryButton}" Click="ReRead_Click" />
            </Grid>

            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="刷新间隔" Style="{StaticResource KeyStyle}" />
                <Slider Grid.Column="1" x:Name="IntervalSlider" Minimum="2" Maximum="60"
                        Style="{StaticResource SliderStyle}"
                        IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,12,0" />
                <TextBlock Grid.Column="2" x:Name="IntervalText" Style="{StaticResource SliderValueStyle}" />
            </Grid>

            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="低电量" Style="{StaticResource KeyStyle}" />
                <Slider Grid.Column="1" x:Name="LowSlider" Minimum="5" Maximum="50"
                        Style="{StaticResource SliderStyle}"
                        IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,12,0" />
                <TextBlock Grid.Column="2" x:Name="LowText" Style="{StaticResource SliderValueStyle}" />
            </Grid>

            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="极低电量" Style="{StaticResource KeyStyle}" />
                <Slider Grid.Column="1" x:Name="CriticalSlider" Minimum="1" Maximum="20"
                        Style="{StaticResource SliderStyle}"
                        IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,12,0" />
                <TextBlock Grid.Column="2" x:Name="CriticalText" Style="{StaticResource SliderValueStyle}" />
            </Grid>

            <TextBlock Style="{StaticResource HintStyle}"
                       Margin="120,0,0,6"
                       Text="跌破阈值时右下角弹窗提醒，同一档只提醒一次。" />

            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="上线通知" Style="{StaticResource KeyStyle}" />
                <CheckBox Grid.Column="1" x:Name="OnlineBox"
                          Content="每次启动后首次读到电量时推送一次通知"
                          Style="{StaticResource CheckStyle}" />
            </Grid>

            <!-- 外观 -->
            <Grid Style="{StaticResource SectionStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Column="1" Style="{StaticResource RuleStyle}" />
            </Grid>

            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="文字颜色" Style="{StaticResource KeyStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="ColorF2" GroupName="TextColor" Tag="#F2F2F2" Style="{StaticResource SwatchStyle}" />
                    <RadioButton x:Name="ColorC8" GroupName="TextColor" Tag="#C8CDD4" Style="{StaticResource SwatchStyle}" />
                    <RadioButton x:Name="Color7F" GroupName="TextColor" Tag="#7FD4FF" Style="{StaticResource SwatchStyle}" />
                    <RadioButton x:Name="Color8B" GroupName="TextColor" Tag="#8BE9A8" Style="{StaticResource SwatchStyle}" />
                    <RadioButton x:Name="ColorFF9" GroupName="TextColor" Tag="#FF9ED2" Style="{StaticResource SwatchStyle}" />
                    <RadioButton x:Name="ColorFFD" GroupName="TextColor" Tag="#FFD666" Style="{StaticResource SwatchStyle}" />
                </StackPanel>
                <Button Grid.Column="2" x:Name="CustomColorButton" Content="自定义…"
                        Style="{StaticResource SecondaryButton}" Click="CustomColor_Click" />
            </Grid>

            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="文字粗细" Style="{StaticResource KeyStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton GroupName="TextWeight" Tag="light" Content="细" Style="{StaticResource OptionStyle}" />
                    <RadioButton GroupName="TextWeight" Tag="normal" Content="常规" Style="{StaticResource OptionStyle}" />
                    <RadioButton GroupName="TextWeight" Tag="semibold" Content="半粗" Style="{StaticResource OptionStyle}" />
                    <RadioButton GroupName="TextWeight" Tag="bold" Content="粗" Style="{StaticResource OptionStyle}" />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="文字大小" Style="{StaticResource KeyStyle}" />
                <Slider Grid.Column="1" x:Name="ScaleSlider" Minimum="80" Maximum="160"
                        Style="{StaticResource SliderStyle}"
                        IsSnapToTickEnabled="True" TickFrequency="5" Margin="0,0,12,0"
                        ValueChanged="ScaleSlider_ValueChanged" />
                <TextBlock Grid.Column="2" x:Name="ScaleText" Style="{StaticResource SliderValueStyle}" />
            </Grid>

            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="排版" Style="{StaticResource KeyStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton GroupName="Layout" Tag="name-first" Content="名称在前" Style="{StaticResource OptionStyle}" />
                    <RadioButton GroupName="Layout" Tag="glyph-first" Content="图标在前" Style="{StaticResource OptionStyle}" />
                    <RadioButton GroupName="Layout" Tag="name-hidden" Content="隐藏名称" Style="{StaticResource OptionStyle}" />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="电量图形" Style="{StaticResource KeyStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton GroupName="GlyphStyle" Tag="battery" Content="电池" Style="{StaticResource OptionStyle}" />
                    <RadioButton GroupName="GlyphStyle" Tag="bar" Content="条形" Style="{StaticResource OptionStyle}" />
                    <RadioButton GroupName="GlyphStyle" Tag="ring" Content="圆环" Style="{StaticResource OptionStyle}" />
                    <RadioButton GroupName="GlyphStyle" Tag="blocks" Content="分段" Style="{StaticResource OptionStyle}" />
                    <RadioButton GroupName="GlyphStyle" Tag="none" Content="无图标" Style="{StaticResource OptionStyle}" />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="充电状态" Style="{StaticResource KeyStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton GroupName="ChargingStyle" Tag="green-fill" Content="绿色填充" Style="{StaticResource OptionStyle}" />
                    <RadioButton GroupName="ChargingStyle" Tag="green-outline" Content="绿色描边" Style="{StaticResource OptionStyle}" />
                    <RadioButton GroupName="ChargingStyle" Tag="green-text" Content="数字变绿" Style="{StaticResource OptionStyle}" />
                    <RadioButton GroupName="ChargingStyle" Tag="none" Content="不区分" Style="{StaticResource OptionStyle}" />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="过渡动画" Style="{StaticResource KeyStyle}" />
                <CheckBox Grid.Column="1" x:Name="AnimationBox" Content="仅浮动面板：电池条 / 圆环 200ms 补间（数字仍是原始读数）"
                          Style="{StaticResource CheckStyle}" />
            </Grid>

            <TextBlock Style="{StaticResource HintStyle}"
                       Margin="120,0,0,6"
                       Text="外观同时作用于任务栏和浮动面板。任务栏高度有限，两台设备时放大会被压回任务栏装得下的大小；要更大的字请改用浮动面板。" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部渐隐：内容没滚到底时盖住被裁切的那一行，避免出现半截控件 -->
                <Border x:Name="BottomFade" Height="26" VerticalAlignment="Bottom"
                        IsHitTestVisible="False" Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00202020" Offset="0" />
                            <GradientStop Color="#FA202020" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- 底部 -->
            <StackPanel Grid.Row="2">
                <Border Height="1" Background="#1CFFFFFF" Margin="0,14,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="AutoStartBox" Content="开机自动运行" Style="{StaticResource CheckStyle}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock x:Name="ApplyHint" VerticalAlignment="Center" Margin="0,0,16,0"
                                   Foreground="#7FBF9A" FontSize="13.5" />
                        <Button Content="取消" Width="96" Height="40" Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
                        <Button Content="应用" Width="96" Height="40" Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButton}" Click="Apply_Click" />
                        <Button Content="保存" Width="96" Height="40"
                                Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
